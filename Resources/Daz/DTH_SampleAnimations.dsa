
// DTH Animation Wizard: Daz Studio clip sampler.
//
// Records, in Daz's own evaluation (keys, interpolation, limits, ERC and all), where every bone of a base Genesis 9 is
// on every frame of each animation clip, and writes one samples file per clip for the Unreal plugin, which recreates
// each frame with the Pose Wizard's measured solve (DTHPoseCore). Nothing in the content library is changed or saved;
// the scene is replaced by a fresh Genesis 9, so the script stops if the open scene has unsaved changes.
//
// A clip is a pose preset (preset_pose) whose channels carry keys over time. It is applied to the figure at frame 0;
// every frame from 0 to its last key is sampled; then its keys are taken off and the figure is set back, so the next
// clip starts from the same rest.
//
// Genesis 8 clips (under People/Genesis 8*) play on a base Genesis 8 figure beside the Genesis 9 and are carried onto G9
// frame by frame (see "Genesis 8 clips" below). Their samples are G9 samples like any other, plus a "source" block that
// says how closely G9 followed G8.
//
// The face: a clip that keys the face (FACS morphs, the bones under the head, the Mouth figure's tongue, the Eyes) gets
// its face sampled on every frame where it moves. A second, never-animated Genesis 9 stands beside the clip's figure; on
// each such frame the clip figure's face values are put on it at frame 0 (the body left out, nothing keyed on the clip)
// and its head, Mouth and Eyes are measured as the Expression Wizard measures an expression (face.json and
// clips/<clip>.face.txt, one line per frame and face figure). The plugin fits DTH's face curves to each frame's shape.
//
// Each role holds "rest" (UnrealPose, DTH ROM frame 1: the rest the solve measures from, as in the Pose Wizard),
// "zero" (the figure as loaded) and "frames". Positions are Daz world space (cm, Y up), rotations Daz world-space
// quaternions [x, y, z, w], in the format of the
// Pose Wizard's samples (DTH_SamplePoses.dsa), so the plugin reads them with the same parser.
//
// Arguments (a global `args`, or the script's first argument):
//   args.files    clip files (absolute, or relative to a content directory). Default: every clip in a folder named
//                 "Animations" under People/Genesis 9* or People/Genesis 8* in every content directory.
//   args.out      output folder (default: Documents/DTH Animation Wizard)
//   args.last     last frame to sample, for quick checks (default: the clip's last key)
//   args.figure   load this figure or scene file instead of base Genesis 9
//   args.resume   true: skip clips whose samples file is already there
//   args.force    true: replace the open scene even if it has unsaved changes (for runs that load their own scene)
//   args.face     false: leave the faces out (default true)
//   args.testFace a list of [frame, {"<figure>|<morph or bone|channel>": value}] to key on the clip figure instead of
//                 loading clips: a face test clip (with args.files empty)
(function(){
	var passed = getArguments();
	var A = (typeof args !== "undefined" && args) ? args : (passed.length && typeof passed[0] == "object" ? passed[0] : {});
	var OUT = A.out || (App.getDocumentsPath() + "/DTH Animation Wizard");
	var FIGURE_FILE = A.figure || "People/Genesis 9/Genesis 9.duf";
	var CHANNELS = ["XRotate", "YRotate", "ZRotate", "XTranslate", "YTranslate", "ZTranslate"];
	// Daz keeps keys inside the animation range: open it wide before a clip is applied.
	var MAX_FRAMES = 100000;
	var TICKS_PER_SECOND = 4800;
	// DazToHue's Genesis 9 ROM: its frame 1 is UnrealPose, the pose DTH's UE bind pose is (the Pose Wizard's rest).
	var ROM_FILE = "DazToHue/Poses/Genesis 9/DQS/G9 DQS JCM FAC - Base.duf";
	var result = {messages: [], clips: [], errors: []};
	var FACE_ON = A.face !== false;
	// The face measured (as the Pose Wizard's sampler does): the head (every vertex above HEAD_DEPTH cm below the top of the
	// figure), the Mouth and the Eyes. Displacements in GEO_UNIT cm integers.
	var FACE_NAMES = ["Genesis9", "Genesis9Mouth", "Genesis9Eyes"];
	var HEAD_DEPTH = 26.0;
	var GEO_UNIT = 1e-4;

	function note(s) { result.messages.push(s); print(s); }
	function exists(path) { return new DzFileInfo(path).exists(); }
	function writeText(path, text) { var f = new DzFile(path); if (!f.open(DzFile.WriteOnly | DzFile.Truncate)) return false; f.write(text); f.close(); return true; }
	function readJson(path) { var f = new DzFile(path); if (!f.open(DzFile.ReadOnly)) return null; var t = f.read(); f.close(); try { return JSON.parse(t); } catch (e) { return null; } }
	function round(v, d) { var m = Math.pow(10, d); return Math.round(v * m) / m; }
	function ticks(t) { return parseInt("" + t, 10); }

	function contentPath(rel) {
		if (/^[A-Za-z]:[\/\\]|^\//.test(rel)) return exists(rel) ? rel : "";
		var mgr = App.getContentMgr();
		for (var i = 0; i < mgr.getNumContentDirectories(); i++) {
			var p = mgr.getContentDirectoryPath(i) + "/" + rel;
			if (exists(p)) return p;
		}
		return "";
	}

	function mainFigure() {
		for (var i = 0; i < Scene.getNumSkeletons(); i++) {
			var s = Scene.getSkeleton(i);
			if (s.getName() == "Genesis9" && !(FACEFIG && FACEFIG.figures[0] == s)) return s;
		}
		return null;
	}
	function channel(b, c) {
		if (c == "XRotate") return b.getXRotControl(); if (c == "YRotate") return b.getYRotControl();
		if (c == "ZRotate") return b.getZRotControl(); if (c == "XTranslate") return b.getXPosControl();
		if (c == "YTranslate") return b.getYPosControl(); return b.getZPosControl();
	}

	// The figure's bones, channels and morphs, looked up once.
	var REFS = null;
	function figureRefs() {
		if (REFS) return REFS;
		var fig = mainFigure(), all = [fig].concat(fig.getAllBones()), bones = [], morphs = [];
		for (var i = 0; i < all.length; i++) {
			var b = all[i], parent = b.getNodeParent(), ch = [];
			for (var c = 0; c < CHANNELS.length; c++) ch.push(channel(b, CHANNELS[c]));
			bones.push({node: b, name: b.getName(), parent: parent && parent.inherits("DzBone") ? parent.getName() : "", channels: ch});
		}
		var obj = fig.getObject();
		for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
			var mod = obj.getModifier(m);
			if (mod && mod.inherits("DzMorph")) morphs.push([mod.getName(), mod.getValueControl()]);
		}
		REFS = {bones: bones, morphs: morphs};
		return REFS;
	}

	// Every bone's world transform and evaluated local channels, and every morph that is not zero, at the current time.
	function sample() {
		var refs = figureRefs(), bones = {}, morphs = {};
		for (var i = 0; i < refs.bones.length; i++) {
			var b = refs.bones[i], p = b.node.getWSPos(), r = b.node.getWSRot(), local = [];
			for (var c = 0; c < b.channels.length; c++) local.push(round(b.channels[c].getValue(), 6));
			bones[b.name] = {parent: b.parent, pos: [round(p.x, 6), round(p.y, 6), round(p.z, 6)],
				rot: [round(r.x, 8), round(r.y, 8), round(r.z, 8), round(r.w, 8)], local: local};
		}
		for (var m = 0; m < refs.morphs.length; m++) {
			var v = refs.morphs[m][1].getValue();
			if (Math.abs(v) > 1e-6) morphs[refs.morphs[m][0]] = round(v, 6);
		}
		return {bones: bones, morphs: morphs};
	}

	// A property's keys, as [time, value] pairs.
	function keysOf(p) {
		var out = [], n = p.getNumKeys ? p.getNumKeys() : 0;
		for (var k = 0; k < n; k++) out.push([ticks(p.getKeyTime(k)), p.getKeyValue(k)]);
		return out;
	}
	function sameKeys(p, keys) {
		var n = p.getNumKeys ? p.getNumKeys() : 0;
		if (n != keys.length) return false;
		for (var k = 0; k < n; k++) if (ticks(p.getKeyTime(k)) != keys[k][0] || p.getKeyValue(k) != keys[k][1]) return false;
		return true;
	}

	// Numeric properties of every figure, bone and morph, with their keys, to set the figure back after a clip.
	function snapshot() {
		var snap = [];
		function add(p) { if (p && p.inherits("DzNumericProperty")) snap.push([p, p.getRawValue(), p.getNumKeys ? p.getNumKeys() : 0, keysOf(p)]); }
		for (var s = 0; s < Scene.getNumSkeletons(); s++) {
			var fig = Scene.getSkeleton(s), nodes = [fig].concat(fig.getAllBones());
			for (var i = 0; i < nodes.length; i++)
				for (var n = 0; n < nodes[i].getNumProperties(); n++) add(nodes[i].getProperty(n));
			var obj = fig.getObject();
			for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
				var mod = obj.getModifier(m);
				if (mod && mod.inherits("DzMorph")) add(mod.getValueControl());
			}
		}
		return snap;
	}
	// Puts every property's keys back exactly as they were, then its value. Daz holds a default key on frame 0 on many
	// properties (a fresh Genesis 9's bones and morphs); a clip that keys a channel only from a later frame eases in from
	// that key, so it must survive: taking every key off instead left the next clip holding its first key's value from
	// frame 0 (spine2 and neck1 of G9 clip 001 after a Genesis 8 clip, 0.65 deg, the head 0.7 cm off, 2026-11-08).
	function restore(snap) {
		for (var i = 0; i < snap.length; i++) {
			var p = snap[i][0], keys = snap[i][3];
			if (p.getNumKeys && !sameKeys(p, keys)) {
				p.deleteAllKeys();
				for (var k = 0; k < keys.length; k++) p.setValue(keys[k][0], keys[k][1]);
			}
			// A keyed property's keys are its value; setting it here would key the current time.
			if (!keys.length && p.getRawValue() != snap[i][1]) p.setValue(snap[i][1]);
		}
	}

	// Properties the clip keyed: the last key (in frames), and the keyed morphs, which v1 does not recreate.
	function keyInfo(snap, step) {
		var last = 0, keyedMorphs = [], keyedBones = 0;
		for (var i = 0; i < snap.length; i++) {
			var p = snap[i][0], n = p.getNumKeys ? p.getNumKeys() : 0;
			if (n == snap[i][2]) continue;
			for (var k = 0; k < n; k++) last = Math.max(last, Math.round(ticks(p.getKeyTime(k)) / step));
			var owner = p.getOwner ? p.getOwner() : null;
			if (owner && owner.inherits("DzMorph")) {
				// Only keys that move the morph off its value before the clip: many clips key every face morph to 0 on frame 0.
				var moves = false;
				for (var kv = 0; kv < n && !moves; kv++) moves = Math.abs(p.getKeyValue(kv) - snap[i][1]) > 1e-4;
				if (moves) keyedMorphs.push(owner.getName());
			}
			else if (owner && owner.inherits("DzBone")) keyedBones++;
		}
		return {last: last, keyedMorphs: keyedMorphs, keyedChannels: keyedBones};
	}

	// Base Genesis 9 as Daz ships it: a product that switches its own morph on for every Genesis 9 (a character's HD
	// details, for one) makes the figure something else, and its face no longer lines up with a base DTH export. Every
	// morph that is on but is not one of Daz's own Genesis 9 morphs (facs_, head_, body_) is set to 0, and named.
	function baseOnly() {
		var off = [];
		for (var s = 0; s < Scene.getNumSkeletons(); s++) {
			var fig = Scene.getSkeleton(s), obj = fig.getObject();
			if (fig.getName().indexOf("Genesis9") != 0) continue;
			for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
				var mod = obj.getModifier(m);
				if (!mod || !mod.inherits("DzMorph")) continue;
				var name = mod.getName(), vc = mod.getValueControl();
				if (name.indexOf("facs_") == 0 || name.indexOf("head_") == 0 || name.indexOf("body_") == 0) continue;
				if (Math.abs(vc.getRawValue()) < 1e-6) continue;
				vc.setValue(0);
				off.push(fig.getName() + " " + name);
			}
		}
		if (off.length) note("Set to 0 on the base figure (a product switches them on for every Genesis 9): " + off.join(", ") + ".");
	}

	function loadFigure(again) {
		if (Scene.needsSave() && !A.force && !again) { result.error = "The open scene has unsaved changes. Save or close it, then run this again."; return false; }
		Scene.clear();
		REFS = null;
		var fig = contentPath(FIGURE_FILE);
		if (!fig) { result.error = "Genesis 9 is not installed (" + FIGURE_FILE + ")."; return false; }
		App.getContentMgr().openFile(fig, true);
		if (!mainFigure()) { result.error = "Loading " + FIGURE_FILE + " did not give a Genesis9 figure."; return false; }
		if (!A.figure) baseOnly();
		var range = new DzTimeRange(0, MAX_FRAMES * Scene.getTimeStep());
		Scene.setAnimRange(range); Scene.setPlayRange(range);
		Scene.setTime(0);
		return true;
	}

	// A clip from a People/Genesis 8* folder plays on its own G8 figure and is carried onto G9.
	function clipEntry(pack, file) {
		var e = {pack: pack, file: file};
		if (/People\/Genesis 8/.test(pack)) e.source = g8Kind(file);
		return e;
	}

	// Every clip under People/Genesis 9*/.../Animations and People/Genesis 8*/.../Animations in every content directory.
	function findClips() {
		var out = [], seen = {}, mgr = App.getContentMgr();
		function walk(dir, rel) {
			var d = new DzDir(dir), files = d.entryList(["*.duf"], DzDir.Files, DzDir.Name);
			for (var i = 0; i < files.length; i++) if (!seen[rel + "/" + files[i]]) { seen[rel + "/" + files[i]] = true; out.push(clipEntry(rel, dir + "/" + files[i])); }
			var dirs = d.entryList(DzDir.Dirs | DzDir.NoDotAndDotDot, DzDir.Name);
			for (var j = 0; j < dirs.length; j++) walk(dir + "/" + dirs[j], rel + "/" + dirs[j]);
		}
		for (var c = 0; c < mgr.getNumContentDirectories(); c++) {
			var people = mgr.getContentDirectoryPath(c) + "/People";
			if (!exists(people)) continue;
			var figs = new DzDir(people).entryList(DzDir.Dirs | DzDir.NoDotAndDotDot, DzDir.Name);
			for (var f = 0; f < figs.length; f++)
				if ((figs[f].indexOf("Genesis 9") == 0 || figs[f].indexOf("Genesis 8") == 0) && exists(people + "/" + figs[f] + "/Animations"))
					walk(people + "/" + figs[f] + "/Animations", "People/" + figs[f] + "/Animations");
		}
		return out;
	}

	// ---- Genesis 8 clips, carried onto Genesis 9 ----
	// A Genesis 8 clip is applied to a base Genesis 8 figure loaded beside the Genesis 9 (same origin). On each frame every G9
	// body bone is turned to G8's matching bone in world space, so it points where G8's points (its bend axes onto G8's), and
	// the hip moves by G8's hip travel scaled by the two hip heights. Then G9 is sampled as for its own clips, so the result
	// is the same samples format. G9's joint limits are off while a G8 clip plays: G8 clips go past them (clip 001 bends
	// G8's knee 28 deg sideways, G9 allows 5), and following G8's movement is the point. How far past is reported per clip.
	var G8 = {Genesis8Female: "People/Genesis 8 Female/Genesis 8 Basic Female.duf", Genesis8Male: "People/Genesis 8 Male/Genesis 8 Basic Male.duf"};
	// G9 bone <- [G8 bone, and for bones with a segment: G8 segment start, G8 segment end, G9 segment end].
	var G8MAP = (function() {
		var m = {hip: ["hip"], pelvis: ["pelvis"], spine1: ["abdomenLower", "abdomenLower", "abdomenUpper", "spine2"],
			spine2: ["abdomenUpper", "abdomenUpper", "chestLower", "spine3"], spine3: ["chestLower", "chestLower", "chestUpper", "spine4"],
			spine4: ["chestUpper", "chestUpper", "neckLower", "neck1"], neck1: ["neckLower", "neckLower", "neckUpper", "neck2"],
			neck2: ["neckUpper", "neckUpper", "head", "head"], head: ["head"], lowerjaw: ["lowerJaw"]};
		var sides = ["l", "r"], toes = ["index", "mid", "ring", "pinky"], f8 = ["Thumb", "Index", "Mid", "Ring", "Pinky"], f9 = ["thumb", "index", "mid", "ring", "pinky"];
		for (var s = 0; s < 2; s++) {
			var a = sides[s], b = a + "_";
			m[b + "eye"] = [a + "Eye"]; m[b + "pectoral"] = [a + "Pectoral"];
			m[b + "shoulder"] = [a + "Collar", a + "Collar", a + "ShldrBend", b + "upperarm"];
			// G8's bend/twist pairs: G9's bone takes the twist bone's world rotation (bend and twist together).
			m[b + "upperarm"] = [a + "ShldrTwist", a + "ShldrBend", a + "ForearmBend", b + "forearm"];
			m[b + "forearm"] = [a + "ForearmTwist", a + "ForearmBend", a + "Hand", b + "hand"];
			m[b + "hand"] = [a + "Hand", a + "Hand", a + "Mid1", b + "mid1"];
			m[b + "thigh"] = [a + "ThighTwist", a + "ThighBend", a + "Shin", b + "shin"];
			m[b + "shin"] = [a + "Shin", a + "Shin", a + "Foot", b + "foot"];
			m[b + "foot"] = [a + "Foot", a + "Foot", a + "Toe", b + "toes"];
			m[b + "metatarsal"] = [a + "Metatarsals"];
			m[b + "toes"] = [a + "Toe"];
			m[b + "bigtoe1"] = [a + "BigToe", a + "BigToe", a + "BigToe_2", b + "bigtoe2"]; m[b + "bigtoe2"] = [a + "BigToe_2"];
			for (var t = 0; t < 4; t++) {
				m[b + toes[t] + "toe1"] = [a + "SmallToe" + (t + 1), a + "SmallToe" + (t + 1), a + "SmallToe" + (t + 1) + "_2", b + toes[t] + "toe2"];
				m[b + toes[t] + "toe2"] = [a + "SmallToe" + (t + 1) + "_2"];
			}
			for (var f = 0; f < 5; f++) {
				m[b + f9[f] + "1"] = [a + f8[f] + "1", a + f8[f] + "1", a + f8[f] + "2", b + f9[f] + "2"];
				m[b + f9[f] + "2"] = [a + f8[f] + "2", a + f8[f] + "2", a + f8[f] + "3", b + f9[f] + "3"];
				m[b + f9[f] + "3"] = [a + f8[f] + "3"];
				if (f > 0) m[b + f9[f] + "metacarpal"] = [a + "Carpal" + f, a + "Carpal" + f, a + f8[f] + "1", b + f9[f] + "1"];
			}
		}
		return m;
	})();
	// Quaternions as [x, y, z, w]. A Daz quaternion value turns vectors as its conjugate (measured: a child's offset from its
	// parent follows conj(getWSRot)), so the physical rotations below are conjugated going in and out of Daz.
	function qv(d) { return [d.x, d.y, d.z, d.w]; }
	function dzq(a) { var r = new DzQuat(); r.x = a[0]; r.y = a[1]; r.z = a[2]; r.w = a[3]; return r; }
	function qmul(a, b) { return [a[3]*b[0]+a[0]*b[3]+a[1]*b[2]-a[2]*b[1], a[3]*b[1]-a[0]*b[2]+a[1]*b[3]+a[2]*b[0], a[3]*b[2]+a[0]*b[1]-a[1]*b[0]+a[2]*b[3], a[3]*b[3]-a[0]*b[0]-a[1]*b[1]-a[2]*b[2]]; }
	function qinv(a) { return [-a[0], -a[1], -a[2], a[3]]; }
	function qnorm(a) { var n = Math.sqrt(a[0]*a[0]+a[1]*a[1]+a[2]*a[2]+a[3]*a[3]); return [a[0]/n, a[1]/n, a[2]/n, a[3]/n]; }
	function qangle(a, b) { var d = Math.abs(a[0]*b[0]+a[1]*b[1]+a[2]*b[2]+a[3]*b[3]); return 2 * Math.acos(Math.min(1, d)) * 180 / Math.PI; }
	function vsub(a, b) { return [a.x - b.x, a.y - b.y, a.z - b.z]; }
	function vunit(v) { var n = Math.sqrt(v[0]*v[0]+v[1]*v[1]+v[2]*v[2]); return [v[0]/n, v[1]/n, v[2]/n]; }
	function vangle(u, v) { u = vunit(u); v = vunit(v); return Math.acos(Math.max(-1, Math.min(1, u[0]*v[0]+u[1]*v[1]+u[2]*v[2]))) * 180 / Math.PI; }
	function between(u, v) {
		u = vunit(u); v = vunit(v);
		return qnorm([u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0], 1 + u[0]*v[0]+u[1]*v[1]+u[2]*v[2]]);
	}
	function figureNamed(name) { for (var i = 0; i < Scene.getNumSkeletons(); i++) if (Scene.getSkeleton(i).getName() == name) return Scene.getSkeleton(i); return null; }
	function g8Kind(path) {
		// The clip's own figure: the pack keeps G8 Female and Male clips in one folder, so the file name decides.
		var name = new DzFileInfo(path).completeBaseName();
		if (/Female/i.test(name)) return "Genesis8Female";
		if (/Male/i.test(name)) return "Genesis8Male";
		return /Genesis 8 Male/i.test(path) ? "Genesis8Male" : "Genesis8Female";
	}
	// Loads a base G8 figure beside G9 and measures, at rest, how each G9 bone lines up with its G8 bone.
	var RETARGET = {};
	var KEEP_REST = {hip: 1, pelvis: 1, head: 1, lowerjaw: 1, l_eye: 1, r_eye: 1, l_pectoral: 1, r_pectoral: 1};
	function loadSource(kind) {
		var file = contentPath(G8[kind]);
		if (!file) { result.errors.push(kind + " is not installed (" + G8[kind] + "): its clips are skipped."); return null; }
		Scene.selectAllNodes(false);
		App.getContentMgr().openFile(file, true);
		var g8 = figureNamed(kind), g9 = mainFigure();
		if (!g8) { result.errors.push("Loading " + G8[kind] + " did not give a " + kind + " figure: its clips are skipped."); return null; }
		// The carry is measured between base Genesis 8 and base Genesis 9, so its result is a Genesis 9 clip like any other,
		// the same on every character. Sampled on a character (args.figure), a base Genesis 9 is loaded beside it to measure
		// on, then taken out again.
		var nodes = Scene.getNumNodes(), ref = g9;
		if (A.figure) {
			var base = contentPath("People/Genesis 9/Genesis 9.duf");
			if (!base) { result.errors.push("Base Genesis 9 is not installed: the Genesis 8 clips are skipped."); return null; }
			Scene.selectAllNodes(false);
			App.getContentMgr().openFile(base, true);
			for (var sk = 0; sk < Scene.getNumSkeletons(); sk++)
				if (Scene.getSkeleton(sk).getName() == "Genesis9" && Scene.getSkeleton(sk) != g9) ref = Scene.getSkeleton(sk);
			if (ref == g9) { result.errors.push("Loading base Genesis 9 did not give a second Genesis9 figure: the Genesis 8 clips are skipped."); return null; }
		}
		var aligned = {}, plan = [], bones9 = g9.getAllBones(), hip8 = g8.findBone("hip"), hip9 = g9.findBone("hip");
		for (var i = 0; i < bones9.length; i++) {
			var m = G8MAP[bones9[i].getName()], src = m ? g8.findBone(m[0]) : null;
			if (!src) continue;
			// Rest world rotations are identity on both figures, so the alignment works on world directions and orientations.
			// A bone with a segment is turned to point along G8's (the swing), then about that line by the part of the
			// orientation difference that is a twist about it, so its bend axes come closest to G8's. End bones without a segment
			// (finger and toe tips, toes, metatarsals) take their parent's alignment, so their local rotation is G8's and G9's
			// locked channels aren't asked to move. The hip, pelvis, head, jaw, eyes and pectorals keep G9's own rest, so they
			// face where G8's do.
			var parent = bones9[i].getNodeParent(), align = [0, 0, 0, 1], at = ref.findBone(bones9[i].getName());
			if (m.length < 4 && !KEEP_REST[bones9[i].getName()] && parent && aligned[parent.getName()]) align = aligned[parent.getName()];
			if (m.length == 4) {
				var u9 = vsub(ref.findBone(m[3]).getWSPos(), at.getWSPos()), u8 = vsub(g8.findBone(m[2]).getWSPos(), g8.findBone(m[1]).getWSPos());
				var orient = qmul(qinv(qv(src.getOrientation())), qv(at.getOrientation()));
				var swing = between(u9, u8), r = qmul(orient, qinv(swing)), n = vunit(u8), d = r[0]*n[0] + r[1]*n[1] + r[2]*n[2];
				align = qmul(qnorm([d*n[0], d*n[1], d*n[2], r[3]]), swing);
			}
			aligned[bones9[i].getName()] = align;
			plan.push({dst: bones9[i], name: bones9[i].getName(), src: src, align: align, inv: qinv(align),
				rest9: qv(bones9[i].getWSRot()), rest8inv: qinv(qv(src.getWSRot())),
				seg: m.length == 4 ? [g8.findBone(m[1]), g8.findBone(m[2]), g9.findBone(m[3])] : null,
				controls: [bones9[i].getXRotControl(), bones9[i].getYRotControl(), bones9[i].getZRotControl()]});
		}
		var h8 = hip8.getWSPos(), scale = ref.findBone("hip").getWSPos().y / h8.y;
		for (var n = Scene.getNumNodes() - 1; n >= nodes; n--) Scene.removeNode(Scene.getNode(n));
		function foot(b9, b8) { return {g9: b9, g8: b8, rest9: b9.getWSPos().y, rest8: b8.getWSPos().y}; }
		// The hip travels by G8's, scaled by base G9's hip height over G8's, set on its translation channels as a G9 clip's keys
		// would be (so a character's figure scale applies as it does to G9 clips).
		RETARGET[kind] = {figure: g8, file: G8[kind], plan: plan, hip8: hip8, hip9: hip9, rest8: h8, scale: scale,
			hipChannels: [hip9.getXPosControl(), hip9.getYPosControl(), hip9.getZPosControl()],
			// Floor contact: each ankle's height change since rest, G9 against G8's scaled by the hip heights.
			feet: [foot(g9.findBone("l_foot"), g8.findBone("lFoot")), foot(g9.findBone("r_foot"), g8.findBone("rFoot"))]};
		return RETARGET[kind];
	}
	// Turns G9 to G8 at the current time, top down (getAllBones lists parents first). Returns the worst gaps this frame.
	function retargetFrame(rt, worst) {
		var AXES = ["X", "Y", "Z"];
		for (var k = 0; k < rt.plan.length; k++) {
			var p = rt.plan[k];
			// Physically R9 = (R8 R8rest^-1) A R9rest; in Daz's values that is rest9 A^-1 rest8^-1 w8.
			p.dst.setWSRot(dzq(qmul(qmul(p.rest9, p.inv), qmul(p.rest8inv, qv(p.src.getWSRot())))));
			if (p.dst == rt.hip9) {
				var h = rt.hip8.getWSPos();
				rt.hipChannels[0].setValue((h.x - rt.rest8.x) * rt.scale);
				rt.hipChannels[1].setValue((h.y - rt.rest8.y) * rt.scale);
				rt.hipChannels[2].setValue((h.z - rt.rest8.z) * rt.scale);
			}
		}
		for (var ft = 0; ft < rt.feet.length; ft++) {
			var fo = rt.feet[ft], fg = Math.abs((fo.g9.getWSPos().y - fo.rest9) - (fo.g8.getWSPos().y - fo.rest8) * rt.scale);
			if (fg > worst.footCm) worst.footCm = round(fg, 4);
		}
		for (var j = 0; j < rt.plan.length; j++) {
			var b = rt.plan[j];
			// How well G9 follows: its world rotation against the target (locked channels can't follow) and, for bones with a
			// segment, the angle between its segment and G8's.
			var gap = qangle(qv(b.dst.getWSRot()), qmul(qmul(b.rest9, b.inv), qmul(b.rest8inv, qv(b.src.getWSRot()))));
			if (gap > worst.rotDeg) { worst.rotDeg = round(gap, 4); worst.rotBone = b.name; }
			if (b.seg) {
				var seg = vangle(vsub(b.seg[2].getWSPos(), b.dst.getWSPos()), vsub(b.seg[1].getWSPos(), b.seg[0].getWSPos()));
				if (seg > worst.segDeg) { worst.segDeg = round(seg, 4); worst.segBone = b.name; }
			}
			for (var c = 0; c < 3; c++) {
				var ctl = b.controls[c], v = ctl.getValue(), over = Math.max(v - ctl.getMax(), ctl.getMin() - v, 0);
				if (over > 1e-3 && b.clamped[c]) {
					worst.beyond[b.name + " " + AXES[c]] = Math.max(worst.beyond[b.name + " " + AXES[c]] || 0, round(over, 2));
				}
			}
		}
	}
	function unclamp(rt, on) {
		for (var k = 0; k < rt.plan.length; k++) {
			var p = rt.plan[k];
			if (!p.clamped) p.clamped = [p.controls[0].isClamped(), p.controls[1].isClamped(), p.controls[2].isClamped()];
			for (var c = 0; c < 3; c++) p.controls[c].setIsClamped(on ? false : p.clamped[c]);
		}
	}


	// ---- The face ----------------------------------------------------------------------------------------------------
	// The face figure: a base Genesis 9 loaded beside the clip's figure and never animated, with its Mouth and Eyes.
	var FACEFIG = null;
	function followers(fig) {
		var out = [];
		for (var i = 0; i < Scene.getNumSkeletons(); i++) { var s = Scene.getSkeleton(i); if (s.getFollowTarget && s.getFollowTarget() == fig) out.push(s); }
		return out;
	}
	function loadFaceFigure() {
		// figures already there, by object (a second Genesis 9 may take the same name as the first)
		var before = [];
		for (var i = 0; i < Scene.getNumSkeletons(); i++) before.push(Scene.getSkeleton(i));
		function seen(s) { for (var q = 0; q < before.length; q++) if (before[q] == s) return true; return false; }
		Scene.selectAllNodes(false);
		App.getContentMgr().openFile(contentPath("People/Genesis 9/Genesis 9.duf"), true);
		var fig = null;
		for (var j = 0; j < Scene.getNumSkeletons(); j++) {
			var s = Scene.getSkeleton(j);
			if (!seen(s) && s.getName().indexOf("Genesis9") == 0 && !(s.getFollowTarget && s.getFollowTarget())) fig = s;
		}
		if (!fig) return null;
		var parts = [fig, null, null], f = followers(fig);
		for (var k = 0; k < f.length; k++) {
			if (f[k].getName().indexOf("Mouth") >= 0) parts[1] = f[k];
			if (f[k].getName().indexOf("Eyes") >= 0) parts[2] = f[k];
		}
		// the same base as the clip's figure
		var off = [];
		for (var p = 0; p < 3; p++) {
			var obj = parts[p] ? parts[p].getObject() : null;
			for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
				var mod = obj.getModifier(m);
				if (!mod || !mod.inherits("DzMorph")) continue;
				var name = mod.getName();
				if (name.indexOf("facs_") == 0 || name.indexOf("head_") == 0 || name.indexOf("body_") == 0) continue;
				if (Math.abs(mod.getValueControl().getRawValue()) > 1e-6) mod.getValueControl().setValue(0);
			}
		}
		// out of the clip figure's way (the face is measured against its own rest, so where it stands does not matter)
		fig.getXPosControl().setValue(200);
		return {figures: parts};
	}
	function positions(fig) {
		var obj = fig.getObject();
		obj.forceCacheUpdate(fig, false);
		return obj.getCachedGeom();
	}
	// The face region on the face figure at rest (written as face.json, with the canonical figure names).
	var FACE = null;
	function faceRegion() {
		var out = [];
		for (var f = 0; f < FACEFIG.figures.length; f++) {
			var fig = FACEFIG.figures[f];
			if (!fig) continue;
			var geo = positions(fig), mesh = fig.getObject().getCurrentShape().getGeometry();
			var n = geo.getNumVertices(), top = -1e9, keep = [], local = {};
			for (var v = 0; v < n; v++) top = Math.max(top, geo.getVertex(v).y);
			for (var v2 = 0; v2 < n; v2++) {
				if (f > 0 || geo.getVertex(v2).y > top - HEAD_DEPTH) { local[v2] = keep.length; keep.push(v2); }
			}
			var facets = [];
			for (var k = 0; k < mesh.getNumFacets(); k++) {
				var fc = mesh.getFacet(k), ids = [fc.vertIdx1, fc.vertIdx2, fc.vertIdx3, fc.vertIdx4], ok = true, row = [];
				for (var c = 0; c < 4; c++) {
					if (ids[c] < 0) { row.push(-1); continue; }
					if (local[ids[c]] === undefined) { ok = false; break; }
					row.push(local[ids[c]]);
				}
				if (ok) facets.push(row);
			}
			// the rest relative to the figure's own position, so the face figure may stand anywhere
			var rest = [], o = FACEFIG.figures[0].getWSPos();
			for (var r = 0; r < keep.length; r++) { var p = geo.getVertex(keep[r]); rest.push(p.x - o.x, p.y - o.y, p.z - o.z); }
			out.push({name: FACE_NAMES[f], vertices: keep, facets: facets, rest: rest, figure: f});
		}
		return out;
	}
	function faceGeometryLines(index) {
		var lines = [], o = FACEFIG.figures[0].getWSPos();
		for (var f = 0; f < FACE.length; f++) {
			var geo = positions(FACEFIG.figures[FACE[f].figure]), parts = [], count = 0, R = FACE[f].rest;
			for (var i = 0; i < FACE[f].vertices.length; i++) {
				var p = geo.getVertex(FACE[f].vertices[i]);
				var dx = Math.round((p.x - o.x - R[3 * i]) / GEO_UNIT), dy = Math.round((p.y - o.y - R[3 * i + 1]) / GEO_UNIT), dz = Math.round((p.z - o.z - R[3 * i + 2]) / GEO_UNIT);
				if (dx || dy || dz) { parts.push(i, dx, dy, dz); ++count; }
			}
			lines.push(index + " " + f + " " + count + (count ? " " + parts.join(" ") : ""));
		}
		return lines;
	}
	// A figure's face properties by a name that is the same on the clip's figure and the face figure: "<part>|p|<property>"
	// for the figure's own properties (a pack's expression alias), "<part>|m|<morph>"
	// for every morph but the body's own (body_), "<part>|b|<bone>|<channel>" for the bones under the head (the main figure) and every bone
	// of the Mouth and Eyes (parts 0, 1, 2).
	function faceProps(parts) {
		var out = {};
		for (var s = 0; s < parts.length; s++) {
			var fig = parts[s];
			if (!fig) continue;
			// the figure's own properties (a pack's expression alias lives here), not its placement in the scene
			var place = [fig.getXPosControl(), fig.getYPosControl(), fig.getZPosControl(), fig.getXRotControl(), fig.getYRotControl(),
				fig.getZRotControl(), fig.getScaleControl(), fig.getXScaleControl(), fig.getYScaleControl(), fig.getZScaleControl()];
			for (var fpn = 0; fpn < fig.getNumProperties(); fpn++) {
				var fpp = fig.getProperty(fpn), isPlace = false;
				for (var pl = 0; pl < place.length; pl++) if (place[pl] == fpp) isPlace = true;
				if (!isPlace && fpp.getName().indexOf("body_") != 0 && fpp.inherits("DzNumericProperty")) out[s + "|p|" + fpp.getName()] = fpp;
			}
			var bones = fig.getAllBones(), head = null, i;
			for (i = 0; i < bones.length; i++) if (bones[i].getName() == "head") head = bones[i];
			for (i = 0; i < bones.length; i++) {
				var b = bones[i], under = s > 0;
				if (s == 0 && head) { var q = b.getNodeParent(); while (q && q != head) q = q.getNodeParent(); under = q == head; }
				if (!under) continue;
				for (var c = 0; c < CHANNELS.length; c++) out[s + "|b|" + b.getName() + "|" + CHANNELS[c]] = channel(b, CHANNELS[c]);
			}
			var obj = fig.getObject();
			for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
				var mod = obj.getModifier(m);
				if (!mod || !mod.inherits("DzMorph")) continue;
				var name = mod.getName();
				// a face value: any morph but the body's own (body_); a pack's expression morph drives FACS
				if (name.indexOf("body_") != 0) out[s + "|m|" + name] = mod.getValueControl();
			}
		}
		return out;
	}
	// The clip figure's face properties the clip keyed, each with the face figure's own: [[clip property, face property]].
	function clipFace(main, snap) {
		var keyed = [];
		var parts = [main, null, null], f = followers(main);
		for (var k = 0; k < f.length; k++) {
			if (f[k].getName().indexOf("Mouth") >= 0) parts[1] = f[k];
			if (f[k].getName().indexOf("Eyes") >= 0) parts[2] = f[k];
		}
		// the properties the clip keyed (one pass over the snapshot), then the face ones among them
		var changed = [];
		for (var i = 0; i < snap.length; i++) { var sp = snap[i][0]; if (sp.getNumKeys && sp.getNumKeys() != snap[i][2]) changed.push(sp); }
		if (!changed.length) return keyed;
		var mine = faceProps(parts), theirs = faceProps(FACEFIG.figures);
		for (var key in mine) {
			var p = mine[key];
			if (typeof p != "object" || !p || !theirs[key]) continue;
			for (var c = 0; c < changed.length; c++) if (changed[c] == p) { keyed.push([p, theirs[key]]); break; }
		}
		return keyed;
	}

	function safeName(s) { return s.replace(/[^A-Za-z0-9_\-]+/g, "_").replace(/_+/g, "_").replace(/^_|_$/g, ""); }

	function sampleClip(clip, rest, zero, snap) {
		var info = new DzFileInfo(clip.file), label = clip.test ? "FaceTest" : info.completeBaseName();
		var outFile = OUT + "/clips/" + safeName(clip.pack + "_" + label) + ".json";
		var summaryFile = outFile.substring(0, outFile.length - 5) + ".summary.json";
		if (A.resume && exists(outFile) && exists(summaryFile)) {
			var kept = readJson(summaryFile);
			if (kept) { kept.resumed = true; result.clips.push(kept); return; }
		}
		var rt = clip.source ? RETARGET[clip.source] : null;
		if (clip.source && !rt) { result.errors.push(clip.file + ": " + clip.source + " is not loaded, so this Genesis 8 clip is skipped."); return; }
		var main = rt ? rt.figure : mainFigure(), nodes = Scene.getNumNodes(), step = ticks(Scene.getTimeStep());
		Scene.setTime(0);
		Scene.selectAllNodes(false); main.select(true); Scene.setPrimarySelection(main);
		var started = new Date().getTime();
		var ok = clip.test ? true : App.getContentMgr().openFile(clip.file, true);
		if (Scene.getNumNodes() != nodes) {
			for (var n = Scene.getNumNodes() - 1; n >= nodes; n--) Scene.removeNode(Scene.getNode(n));
			restore(snap);
			result.errors.push(clip.file + ": not an animation clip (it adds items to the scene).");
			return;
		}
		if (!ok) { restore(snap); result.errors.push(clip.file + ": Daz could not load it."); return; }
		var keys = keyInfo(snap, step);
		var face = FACE_ON && FACEFIG ? clipFace(main, snap) : [], faceLines = [], faceFrames = 0, lastValues = null;
		var last = typeof A.last == "number" ? Math.min(A.last, keys.last) : keys.last;
		var loaded = new Date().getTime(), frames = [], worst = {rotDeg: 0, rotBone: "", segDeg: 0, segBone: "", beyond: {}, footCm: 0};
		if (rt) unclamp(rt, true);
		for (var fr = 0; fr <= last; fr++) {
			Scene.setTime(fr * Scene.getTimeStep());
			if (rt) retargetFrame(rt, worst);
			frames.push(sample());
			if (face.length) {
				// the clip's face values on this frame, put on the face figure at frame 0 and measured there
				var values = [], same = !!lastValues;
				for (var fv = 0; fv < face.length; fv++) { values.push(face[fv][0].getRawValue()); if (same && values[fv] != lastValues[fv]) same = false; }
				if (!same) {
					Scene.setTime(0);
					for (var fs = 0; fs < face.length; fs++) if (face[fs][1].getRawValue() != values[fs]) face[fs][1].setValue(values[fs]);
					faceLines.push(faceGeometryLines(fr).join("\n"));
					faceFrames++;
					lastValues = values;
				}
				else faceLines.push(faceLines.length ? faceLines[faceLines.length - 1].replace(/^\d+ /gm, fr + " ") : "");
			}
		}
		var sampled = new Date().getTime();
		Scene.setTime(0);
		restore(snap);
		if (rt) unclamp(rt, false);
		var source = null;
		if (rt) {
			var beyond = [];
			for (var bk in worst.beyond) beyond.push([bk, worst.beyond[bk]]);
			beyond.sort(function(x, y) { return y[1] - x[1]; });
			source = {figure: clip.source, file: rt.file, hipScale: round(rt.scale, 6),
				// G9's world rotation against G8's (after the rest alignment): only locked G9 channels leave a gap.
				maxRotationGapDeg: worst.rotDeg, maxRotationGapBone: worst.rotBone,
				// The angle between each G9 bone with a segment and G8's: what the eye sees.
				maxSegmentGapDeg: worst.segDeg, maxSegmentGapBone: worst.segBone,
				// Floor contact: the ankles' height change since rest against G8's, scaled by the hip heights.
				maxFootHeightGapCm: worst.footCm,
				// G9 channels past G9's joint limits, worst first: [bone axis, degrees past].
				beyondG9Limits: beyond};
		}
		var back = sample(), drift = 0;
		for (var b in zero.bones) {
			var p = zero.bones[b].pos, q = back.bones[b] ? back.bones[b].pos : p;
			drift = Math.max(drift, Math.abs(p[0] - q[0]), Math.abs(p[1] - q[1]), Math.abs(p[2] - q[2]));
		}
		var doc = {format: "DTH Animation Samples", version: 1, sampledAt: new Date().toISOString(), dazVersion: App.longVersionString,
			units: "cm, Y up, Daz world space", figure: FIGURE_FILE,
			clip: {label: label, pack: clip.pack, file: clip.file},
			fps: TICKS_PER_SECOND / step, firstFrame: 0, lastFrame: last, lastKey: keys.last,
			keyedChannels: keys.keyedChannels, keyedMorphs: keys.keyedMorphs, source: source,
			timing: {loadMs: loaded - started, sampleMs: sampled - loaded},
			restoreDriftCm: round(drift, 6),
			roles: [{label: "", figure: "Genesis9", rest: rest, zero: zero, frames: frames}]};
		new DzDir(OUT + "/clips").mkpath(OUT + "/clips");
		if (face.length) {
			var faceFile = outFile.substring(0, outFile.length - 5) + ".face.txt";
			writeText(faceFile, faceLines.join("\n"));
			doc.face = "../face.json";
			doc.faceGeometry = new DzFileInfo(faceFile).fileName();
			doc.faceKeyed = face.length;
		}
		if (!writeText(outFile, JSON.stringify(doc))) { result.errors.push(clip.file + ": could not write " + outFile); return; }
		var summary = {label: label, file: clip.file, samples: outFile, frames: last + 1, fps: doc.fps, faceFrames: faceFrames,
			sampleMs: sampled - loaded, keyedMorphs: keys.keyedMorphs.length, restoreDriftCm: doc.restoreDriftCm};
		if (source) { summary.source = source.figure; summary.maxSegmentGapDeg = source.maxSegmentGapDeg; summary.maxRotationGapDeg = source.maxRotationGapDeg; summary.beyondG9Limits = source.beyondG9Limits.length; }
		writeText(summaryFile, JSON.stringify(summary));
		result.clips.push(summary);
		note(label + ": " + (last + 1) + " frames in " + (sampled - loaded) + " ms" + (face.length ? ", its face on " + faceFrames + " frames" : "") + ".");
	}

	// A face test clip (args.testFace): the given face values keyed on the clip's figure, then sampled like a clip.
	function sampleTestClip(rest, zero, snap) {
		var main = mainFigure(), parts = [main, null, null], f = followers(main);
		for (var k = 0; k < f.length; k++) {
			if (f[k].getName().indexOf("Mouth") >= 0) parts[1] = f[k];
			if (f[k].getName().indexOf("Eyes") >= 0) parts[2] = f[k];
		}
		var props = faceProps(parts), step = Scene.getTimeStep();
		for (var i = 0; i < A.testFace.length; i++) {
			var fr = A.testFace[i][0], set = A.testFace[i][1];
			for (var key in set) if (typeof set[key] == "number" && props[key]) props[key].setValue(fr * step, set[key]);
		}
		sampleClip({file: "", pack: "Test", source: null, test: true}, rest, zero, snap);
	}

	// UnrealPose: DTH's ROM applied, frame 1 sampled, the ROM taken off again.
	function sampleUnrealPose(snap) {
		var rom = contentPath(ROM_FILE), main = mainFigure();
		if (!rom) { result.error = "DazToHue's Genesis 9 ROM preset (" + ROM_FILE + ") is missing."; return null; }
		Scene.setTime(0);
		Scene.selectAllNodes(false); main.select(true); Scene.setPrimarySelection(main);
		App.getContentMgr().openFile(rom, true);
		Scene.setTime(Scene.getTimeStep());
		var s = sample();
		Scene.setTime(0);
		restore(snap);
		return s;
	}

	if (!loadFigure()) return result;
	var clips = [];
	if (A.files) {
		for (var f = 0; f < A.files.length; f++) {
			var path = contentPath(A.files[f]);
			if (path) clips.push(clipEntry(new DzFileInfo(path).path().replace(/^.*\/People\//, "People/"), path));
			else result.errors.push(A.files[f] + ": not found in any content directory.");
		}
	}
	else clips = findClips();
	var zero = sample(), rest = sampleUnrealPose(snapshot());
	if (!rest) return result;
	// A fresh figure for the clips: taking the ROM off leaves the first clip sampled after it off on frame 0 (up to 0.55 cm at
	// the head, against the same clip on a figure that never had the ROM: DTH.Anim.P3.SameAsOneScene, 2026-11-07).
	if (!loadFigure(true)) return result;
	var fresh = sample(), zeroDrift = 0;
	for (var zb in zero.bones) {
		var zp = zero.bones[zb].pos, fp = fresh.bones[zb] ? fresh.bones[zb].pos : zp;
		zeroDrift = Math.max(zeroDrift, Math.abs(zp[0] - fp[0]), Math.abs(zp[1] - fp[1]), Math.abs(zp[2] - fp[2]));
	}
	if (zeroDrift > 1e-4) note("The reloaded figure differs from the first by " + zeroDrift + " cm.");
	// The face figure, beside the clip's figure, before the snapshot (so restoring covers it too).
	if (FACE_ON) {
		FACEFIG = loadFaceFigure();
		if (!FACEFIG) note("Could not load a second Genesis 9 for the faces: the clips are sampled without them.");
		else { FACE = faceRegion(); writeText(OUT + "/face.json", JSON.stringify({unit: GEO_UNIT, figures: FACE})); }
		Scene.selectAllNodes(false);
	}
	// The Genesis 8 figures the clips need, beside G9, before the snapshot (so restoring covers them too).
	var kinds = {};
	for (var ck = 0; ck < clips.length; ck++) if (clips[ck].source) kinds[clips[ck].source] = true;
	for (var kind in kinds) if (loadSource(kind)) note(kind + " loaded for its clips (hip scale " + round(RETARGET[kind].scale, 4) + ").");
	var snap = snapshot();
	if (A.testFace) sampleTestClip(rest, zero, snap);
	for (var c = 0; c < clips.length; c++) sampleClip(clips[c], rest, zero, snap);
	var index = {format: "DTH Animation Samples Index", version: 1, sampledAt: new Date().toISOString(), clips: result.clips, errors: result.errors};
	writeText(OUT + "/DTH_AnimationSamples.json", JSON.stringify(index));
	result.file = OUT + "/DTH_AnimationSamples.json";
	note("Sampled " + result.clips.length + " clips; " + result.errors.length + " problems.");
	return result;
})();
